GG_ENV=dev
GG_VISION_PROVIDER=mock
GG_POLICY_PATH=configs/retextil_demo.yaml
GG_EVENT_LOG_PATH=data/events.jsonl
GG_REVIEW_THRESHOLD=0.72
GG_PROJECTION_ZONE_M=1.8
